@startuml
scale 0.7
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
top to bottom direction

' =============================
'        PACKAGE: MODUL PERSON
' =============================
package "Modul Person" {
  class Person {
    +Identifikation: Identifier
  }

  class Name {
    +Vorname: string
    +Nachname: string
    +Familienname: string
    +Vorsatzwort: string
    +Namenszusatz: string
    +Präfix: string
    +Art des Präfixes: code
    +Geburtsname: string
  }

  class Demographie {
    +administratives Geschlecht: code
    +Geburtsdatum: dateTime
  }

  class DokumentiertesGeschlecht {
    +Wert: CodeableConcept
    +Typ: CodeableConcept
    +Gültigkeitszeitraum: Period
    +Erfassungszeitpunkt: dateTime
    +Quelle[x]: CodeableConcept | Reference
    +Quelldokument[x]: CodeableConcept | Reference
    +Zuständiger Rechtsraum: CodeableConcept
  }

  class Adresse {
    +Land: string
    +PLZ: string
    +Wohnort: string
    +Straße: string
  }

  class Vitalstatus {
    +Patient verstorben: boolean
    +Todeszeitpunkt: dateTime
    +Zeitpunkt Feststellung Vitalstatus: dateTime
    +Informationsquelle: string
    +Todesursache: CodeableConcept
  }

  class AllergieOderUnvertraeglichkeit {
    +Klinischer Status: CodeableConcept
    +Verifikationsstatus: CodeableConcept
    +Art: code
    +Kategorie: code
    +Kritikalität: code
    +Allergie oder Unverträglichkeit gegen: CodeableConcept
    +Patient: Reference
    +Kontakt: Reference
    +Beginn[x]: dateTime | Age | Period | Range | string
    +Dokumentationsdatum: dateTime
  }

  class UnerwuenschteReaktion {
    +Manifestation: CodeableConcept
    +Schweregrad: code
    +Expositionsweg: CodeableConcept
  }

  class Rolle
  class PatientIn
  class PatientenIdentifikator {
    +Patienten-Identifikator – PID: Identifier
    +Patienten-Identifikator Kontext: CodeableConcept
  }
  class PatientenPseudonym {
    +Pseudonym: Identifier
  }
  class Versicherung {
    +Institutionskennzeichen Krankenkasse: string
    +Versicherungsnummer: string
    +Versicherungstyp: CodeableConcept
  }
}

' =============================
'        PACKAGE: MODUL STUDIE
' =============================
package "Modul Studie" {
  class ProbandIn {
    +Bezeichnung der Studie: Identifier
    +Subjekt-Identifizierungscode – SIC: Identifier
    +Rechtsgrundlage: Reference
    +Beginn Teilnahme: dateTime
    +Ende Teilnahme: dateTime
    +Status der Teilnahme: code
  }
}

' =============================
'        RELATIONSHIPS
' =============================

Person "1..*" -down- "0..1" Name
Person "0..*" -down- "0..1" Demographie
Demographie "0..1" -down- "0..*" DokumentiertesGeschlecht
Person "0..*" -down- "0..*" Adresse
Person "1..*" -down- "0..1" Vitalstatus
Person "1" -down- "0..*" AllergieOderUnvertraeglichkeit
Demographie -[hidden]left- AllergieOderUnvertraeglichkeit
AllergieOderUnvertraeglichkeit "1" *-- "0..*" UnerwuenschteReaktion
Person "1..*" -down- "0..*" Rolle
Rolle <|-- PatientIn
Rolle <|-- ProbandIn

PatientIn "0..1" -down- "1..*" PatientenIdentifikator
PatientIn "0..1" -down- "0..*" Versicherung
PatientIn "0..1" -down- "0..*" PatientenPseudonym

@enduml
